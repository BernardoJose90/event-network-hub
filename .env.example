# Copy to .env to override defaults. No secrets belong here.

# Backend
# PostgreSQL (the compose "postgres" service locally; RDS in the cluster, with the password from
# the secret store). The schema comes from the migrations: alembic upgrade head.
DATABASE_URL=postgresql://enh:enh@postgres:5432/enh
# Connections per process (API pod or worker); mind RDS max_connections when adding pods.
DB_POOL_MAX_SIZE=10
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_SECONDS=90
DATA_DIR=/data
# Uploaded and published files: local (in DATA_DIR) or s3. With s3, credentials come from the
# pod's IAM role (or the usual AWS_* variables locally), and the VAPID keys below are required.
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
# The commit the images are built from (shown by /api/health): GIT_SHA=$(git rev-parse HEAD)
GIT_SHA=

# Sharing the prototype through a tunnel: host names the frontend accepts besides localhost
# (".trycloudflare.com" = any Cloudflare quick tunnel). Set APP_PUBLIC_URL to the tunnel address.
VITE_ALLOWED_HOSTS=.trycloudflare.com

# Feature switches. false = paused: no page, link, API or background jobs; the data is kept.
FEATURE_HELPDESK=true
FEATURE_REPORTS=true
# The Web Summit look (colours, logo, gradient). false = a plain, neutral look.
FEATURE_WEBSUMMIT_THEME=true

# Help desk: WhatsApp bot integration. Leave empty to turn it off.
# BOT_API_TOKEN: the bot sends "Authorization: Bearer <token>" to /api/bot/tickets.
# BOT_CALLBACK_URL: where status updates for reporters are POSTed (needs BOT_CALLBACK_SECRET,
# the HMAC key for the X-Signature header). Inject tokens/secrets from a secret store; never commit them.
BOT_API_TOKEN=
BOT_CALLBACK_URL=
BOT_CALLBACK_SECRET=
APP_PUBLIC_URL=http://localhost:5173

# Notifications. Leave a channel empty to turn it off (in-app notifications always work).
# Browser push: VAPID keys (a key pair is generated into DATA_DIR/vapid.json locally if unset;
# in production set both from the secret store and keep them stable).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ict@websummit.com
# Slack: an incoming webhook URL for the ICT channel (a secret; never commit it).
SLACK_WEBHOOK_URL=
# Email through the organisation's provider (SMTP). The From domain needs SPF, DKIM and DMARC.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Event Network Hub <no-reply@websummit.com>
SMTP_STARTTLS=true
# Comma-separated: emailed when a P1/P2 ticket misses its 5-minute acknowledge SLA.
ESCALATION_EMAILS=

# Frontend (Vite dev server proxy target for /api)
VITE_API_PROXY_TARGET=http://backend:8000
