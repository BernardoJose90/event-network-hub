# Copy to .env to override defaults. No secrets belong here.

# Backend
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_SECONDS=90
DATA_DIR=/data
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO

# Optional areas. false = paused: no page, link, API or background jobs; the data is kept.
FEATURE_HELPDESK=false
FEATURE_REPORTS=false

# Help desk: WhatsApp bot integration. Leave empty to turn it off.
# BOT_API_TOKEN: the bot sends "Authorization: Bearer <token>" to /api/bot/tickets.
# BOT_CALLBACK_URL: where status updates for reporters are POSTed (needs BOT_CALLBACK_SECRET,
# the HMAC key for the X-Signature header). Inject tokens/secrets from a secret store; never commit them.
BOT_API_TOKEN=
BOT_CALLBACK_URL=
BOT_CALLBACK_SECRET=
APP_PUBLIC_URL=http://localhost:5173

# Notifications. Leave a channel empty to turn it off (in-app notifications always work).
# Browser push: VAPID keys (a key pair is generated into DATA_DIR/vapid.json locally if unset;
# in production set both from the secret store and keep them stable).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ict@websummit.com
# Slack: an incoming webhook URL for the ICT channel (a secret; never commit it).
SLACK_WEBHOOK_URL=
# Email through the organisation's provider (SMTP). The From domain needs SPF, DKIM and DMARC.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Event Network Hub <no-reply@websummit.com>
SMTP_STARTTLS=true
# Comma-separated: emailed when a P1/P2 ticket misses its 5-minute acknowledge SLA.
ESCALATION_EMAILS=

# Frontend (Vite dev server proxy target for /api)
VITE_API_PROXY_TARGET=http://backend:8000
