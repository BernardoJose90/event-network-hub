# Copy to .env to override defaults. No secrets belong here.

# Backend
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_SECONDS=90
DATA_DIR=/data
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO

# In-browser editor (Collabora Online)
COLLABORA_URL=http://collabora:9980
WOPI_BASE_URL=http://backend:8000
APP_ORIGIN=http://localhost:5173
COLLABORA_SERVER_NAME=localhost:9980
COLLABORA_WOPI_HOST=http://backend:8000
COLLABORA_FRAME_ANCESTOR=localhost:5173
# Signs editor access tokens. Leave empty locally (a random one is generated per
# start); in production inject it from a secret store, never commit it.
WOPI_TOKEN_SECRET=

# Help desk: WhatsApp bot integration. Leave empty to turn it off.
# BOT_API_TOKEN: the bot sends "Authorization: Bearer <token>" to /api/bot/tickets.
# BOT_CALLBACK_URL: where status updates for reporters are POSTed (needs BOT_CALLBACK_SECRET,
# the HMAC key for the X-Signature header). Inject tokens/secrets from a secret store; never commit them.
BOT_API_TOKEN=
BOT_CALLBACK_URL=
BOT_CALLBACK_SECRET=
APP_PUBLIC_URL=http://localhost:5173

# Frontend (Vite dev server proxy target for /api)
VITE_API_PROXY_TARGET=http://backend:8000
